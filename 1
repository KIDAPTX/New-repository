import sys
import io
# 解决 Windows 终端中文乱码问题
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')

"""
======================================================
Python 第一课：Hello World、注释、变量与数据类型
======================================================
"""

# ============================================
# 一、你的第一个 Python 程序
# ============================================
print("Hello, World!")  # 打印一句话到屏幕上
print("欢迎来到 Python 编程世界！")  # 你可以修改这句话，试着打印你喜欢的内容   

# ============================================
# 二、注释 (Comments)
# ============================================
# 这是单行注释，以 # 开头，Python 不会执行这一行

"""
这是多行注释（文档字符串）
可以写很多行
Python 同样不会执行
"""

# ============================================
# 三、变量 (Variables)
# ============================================
# 变量就像一个带标签的盒子，用来存放数据
name = "小明"       # 字符串类型
age = 25            # 整数类型
height = 1.75       # 浮点数（小数）类型
is_student = True   # 布尔类型（True 或 False）

print("姓名:", name)
print("年龄:", age)
print("身高:", height)
print("是否是学生:", is_student)

# ============================================
# 四、基本数据类型
# ============================================

# 1. 整数 int
a = 10
b = -5
c = 0
print("\n整数:", a, b, c)

# 2. 浮点数 float
pi = 3.14159
price = 9.99
print("浮点数:", pi, price)

# 3. 字符串 str（用单引号或双引号都可以）
greeting = "你好"
city = '北京'
print("字符串:", greeting, city)

# 4. 布尔值 bool
is_raining = False
is_sunny = True
print("布尔值:", is_raining, is_sunny)

# 5. 使用 type() 查看数据类型
print("\n--- 查看数据类型 ---")
print("name 的类型:", type(name))
print("age 的类型:", type(age))
print("height 的类型:", type(height))
print("is_student 的类型:", type(is_student))

# ============================================
# 五、基本运算符
# ============================================

print("\n--- 算术运算符 ---")
x = 10
y = 3

print("加法:", x + y)     # 13
print("减法:", x - y)     # 7
print("乘法:", x * y)     # 30
print("除法:", x / y)     # 3.333... (结果是浮点数)
print("整除:", x // y)    # 3 (去掉小数部分)
print("取余:", x % y)     # 1 (10 除以 3 的余数)
print("乘方:", x ** y)    # 1000 (10 的 3 次方)

# ============================================
# 六、变量命名规则
# ============================================
# ✅ 正确的命名
user_name = "张三"       # 使用下划线分隔（推荐）
firstName = "李四"       # 驼峰命名也可以
_score = 100            # 可以以下划线开头
user2 = "王五"          # 可以包含数字（但不能以数字开头）

# ❌ 错误的命名（取消注释会报错）
# 2user = "错误"         # 不能用数字开头
# my-name = "错误"       # 不能用连字符
# class = "错误"         # 不能用 Python 关键字

print("\n变量命名测试:", user_name, firstName, _score, user2)

print("\n第一课结束！试着运行这个文件看看吧~")
